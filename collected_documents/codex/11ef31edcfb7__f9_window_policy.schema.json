{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cre-foundry.local/schemas/f9-window-policy-v1.json",
  "title": "Strict synthetic F9 window policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_id", "schema_version", "execution_scope", "policy_id", "policy_version", "registered_at", "primary_window_anchor", "horizon_days", "interval_convention", "reporting_grace_seconds", "primary_estimand_unit", "include_abstain_assignments", "include_nonadherent_assignments", "f9_predicate", "censor_causes", "competing_event_causes", "dedupe_scope", "correction_policy", "real_policy_authorized", "owner", "claim_ceiling"],
  "properties": {
    "artifact_id": {"const": "OUTCOMES-001-SYNTHETIC-WINDOW-POLICY"},
    "schema_version": {"const": "1.0.0"},
    "execution_scope": {"const": "SYNTHETIC_NON_INFLUENCING"},
    "policy_id": {"const": "F9-POLICY:SYNTHETIC_ROUTE_DAY_V1"},
    "policy_version": {"const": "1.0.0"},
    "registered_at": {"type": "string", "format": "date-time"},
    "primary_window_anchor": {"const": "ROUTE_DAY_ASSIGNMENT"},
    "horizon_days": {"const": 30},
    "interval_convention": {"const": "CLOSED_START_CLOSED_END_SYNTHETIC"},
    "reporting_grace_seconds": {"const": 0},
    "primary_estimand_unit": {"const": "REPRESENTATIVE_ROUTE_DAY_ITT"},
    "include_abstain_assignments": {"const": true},
    "include_nonadherent_assignments": {"const": true},
    "f9_predicate": {
      "type": "object", "additionalProperties": false,
      "required": ["actor_roles", "requirement_types", "appointment_requirement", "supporting_evidence", "adjudication", "deduplication"],
      "properties": {
        "actor_roles": {"const": ["RELEVANT_DECISION_MAKER", "AUTHORIZED_REPRESENTATIVE"]},
        "requirement_types": {"const": ["CURRENT_CRE_REQUIREMENT", "CREDIBLE_FUTURE_CRE_REQUIREMENT"]},
        "appointment_requirement": {"const": "SCHEDULED_WITH_IDENTIFIED_SENIOR_COMMERCIAL_REALTOR"},
        "supporting_evidence": {"const": "INDEPENDENTLY_ADJUDICABLE_SYNTHETIC"},
        "adjudication": {"const": "PASS_SYNTHETIC"},
        "deduplication": {"const": "CANONICAL_BOOKING_EPISODE"}
      }
    },
    "censor_causes": {"const": ["SYNTHETIC_LOSS_TO_FOLLOW_UP", "SYNTHETIC_SOURCE_OUTAGE", "SYNTHETIC_ACCESS_REVOKED"]},
    "competing_event_causes": {"const": ["SYNTHETIC_TERMINAL_CLOSURE", "SYNTHETIC_IDENTITY_INVALIDATED"]},
    "dedupe_scope": {"const": ["source_namespace", "booking_episode_id", "route_day", "representative", "candidate", "channel"]},
    "correction_policy": {"const": "APPEND_ONLY_SINGLE_PARENT_SINGLE_HEAD"},
    "real_policy_authorized": {"const": false},
    "owner": {
      "type": "object", "additionalProperties": false, "required": ["system", "real_world_authority"],
      "properties": {"system": {"const": "CRE_FOUNDRY"}, "real_world_authority": {"const": "UNASSIGNED_EXTERNAL_AUTHORITY"}}
    },
    "claim_ceiling": {"const": "Synthetic fixture policy only; the real F9 predicate, horizon, anchor, endpoints, grace, adjudication, censoring, competing-event, attribution, and correction rules are human-authoritative."}
  }
}
