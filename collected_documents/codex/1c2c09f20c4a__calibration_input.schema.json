{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cre-foundry.local/schemas/calibration-input-v1.json",
  "title": "Frozen synthetic calibration input registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["document_kind", "schema_version", "execution_scope", "registry_id", "registered_at", "probability_head", "calibrator", "bins", "analysis", "scenarios", "bindings", "claim_ceiling"],
  "properties": {
    "document_kind": {"const": "FROZEN_SYNTHETIC_CALIBRATION_INPUT"},
    "schema_version": {"const": "1.0.0"},
    "execution_scope": {"const": "SYNTHETIC_NON_INFLUENCING"},
    "registry_id": {"const": "CALIBRATION_INPUT:FROZEN_V1"},
    "registered_at": {"const": "2026-04-15T00:00:00Z"},
    "probability_head": {"type": "object", "additionalProperties": false, "required": ["head_id", "target", "estimand_kind", "numeric_domain", "source_policy_id", "all_baseline_policy_streams_are_rank_only"], "properties": {"head_id": {"const": "BETA_BINOMIAL_BUCKET_RAW_POSTERIOR_SYNTHETIC_V1"}, "target": {"const": "F9_WITHIN_REGISTERED_WINDOW_W_GIVEN_STAGE1_POINT_IN_TIME_INFORMATION"}, "estimand_kind": {"const": "OBSERVATIONAL_CANDIDATE_RISK_NOT_CAUSAL_EFFECT_OR_ROUTE_DAY_ITT"}, "numeric_domain": {"const": "CANONICAL_REDUCED_EXACT_RATIONAL_0_TO_1_INCLUSIVE"}, "source_policy_id": {"const": "BETA_BINOMIAL_BUCKET_SYNTHETIC_V1"}, "all_baseline_policy_streams_are_rank_only": {"const": true}}},
    "calibrator": {"type": "object", "additionalProperties": false, "required": ["calibrator_id", "registered_at", "validation_fit_at", "fit_partition", "alpha", "beta", "minimum_cell_count", "unseen_or_sparse_fallback", "test_reuse_allowed"], "properties": {"calibrator_id": {"const": "FIXED_BIN_BETA_BINOMIAL_ALPHA_1_BETA_1:V1"}, "registered_at": {"type": "string", "format": "date-time"}, "validation_fit_at": {"type": "string", "format": "date-time"}, "fit_partition": {"const": "VALIDATION_COMPLETE_CANDIDATE_UNIVERSE_ONLY"}, "alpha": {"const": 1}, "beta": {"const": 1}, "minimum_cell_count": {"const": 4}, "unseen_or_sparse_fallback": {"const": "UNKNOWN_INPUT"}, "test_reuse_allowed": {"const": false}}},
    "bins": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "object", "additionalProperties": false, "required": ["bin_id", "lower", "upper", "upper_inclusive"], "properties": {"bin_id": {"enum": ["B0", "B1", "B2", "B3", "B4"]}, "lower": {"$ref": "#/$defs/pair"}, "upper": {"$ref": "#/$defs/pair"}, "upper_inclusive": {"type": "boolean"}}}},
    "analysis": {"type": "object", "additionalProperties": false, "required": ["subgroup_dimension", "subgroup_values", "temporal_unit", "primary_population", "macro_micro_separate", "uncertainty_status"], "properties": {"subgroup_dimension": {"const": "market_segment"}, "subgroup_values": {"const": ["A", "B", "C", "UNKNOWN"]}, "temporal_unit": {"const": "ROUTE_DAY_CHRONOLOGICAL"}, "primary_population": {"const": "FULL_COMMON_CANDIDATE_UNIVERSE_NOT_SELECTED_TEN"}, "macro_micro_separate": {"const": true}, "uncertainty_status": {"const": "NOT_EMPIRICALLY_ESTIMABLE"}}},
    "scenarios": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "object", "required": ["scenario_id"]}},
    "bindings": {"type": "object", "additionalProperties": false, "required": ["baseline_benchmark_sha256", "baseline_registry_sha256", "baseline_run_sha256", "outcomes_contract_sha256", "outcomes_policy_sha256", "outcomes_run_sha256", "math_contract_sha256", "math_problem_schema_sha256", "math_decision_schema_sha256", "public_evaluator_contract_sha256"], "properties": {"baseline_benchmark_sha256": {"$ref": "#/$defs/sha256"}, "baseline_registry_sha256": {"$ref": "#/$defs/sha256"}, "baseline_run_sha256": {"$ref": "#/$defs/sha256"}, "outcomes_contract_sha256": {"$ref": "#/$defs/sha256"}, "outcomes_policy_sha256": {"$ref": "#/$defs/sha256"}, "outcomes_run_sha256": {"$ref": "#/$defs/sha256"}, "math_contract_sha256": {"$ref": "#/$defs/sha256"}, "math_problem_schema_sha256": {"$ref": "#/$defs/sha256"}, "math_decision_schema_sha256": {"$ref": "#/$defs/sha256"}, "public_evaluator_contract_sha256": {"$ref": "#/$defs/sha256"}}},
    "claim_ceiling": {"type": "string", "minLength": 50}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "pair": {"type": "array", "prefixItems": [{"type": "integer"}, {"type": "integer", "minimum": 1}], "minItems": 2, "maxItems": 2}}
}
