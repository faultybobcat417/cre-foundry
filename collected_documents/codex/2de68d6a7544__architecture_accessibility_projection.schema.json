{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cre-foundry.local/schemas/architecture-accessibility-projection-v1.json",
  "title": "CRE Foundry architecture programmatic accessibility projection",
  "description": "Synthetic programmatic accessibility metadata for every ARCHITECTURE-001 workflow response. Encodes the frozen evaluator contract programmatic_accessibility_contract required status fields and required properties. Establishes synthetic semantics only; no WCAG, assistive-technology, usability, satisfaction, or adoption claim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "projection_id",
    "document_kind",
    "schema_version",
    "execution_scope",
    "claim_kind",
    "status",
    "actions",
    "focus_order",
    "reading_order",
    "errors",
    "location_rows",
    "visual_only",
    "claims_not_established"
  ],
  "properties": {
    "projection_id": {
      "type": "string",
      "minLength": 1
    },
    "document_kind": {
      "const": "ARCHITECTURE_ACCESSIBILITY_PROJECTION"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "execution_scope": {
      "const": "SYNTHETIC_NON_INFLUENCING"
    },
    "claim_kind": {
      "const": "SYNTHETIC_PROGRAMMATIC_SEMANTICS_ONLY"
    },
    "status": {
      "$ref": "#/$defs/status"
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "focus_order": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reading_order": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/error"
      }
    },
    "location_rows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/location_row"
      }
    },
    "visual_only": {
      "const": false
    },
    "claims_not_established": {
      "const": [
        "WCAG_CONFORMANCE",
        "SCREEN_READER_PERFORMANCE",
        "REPRESENTATIVE_USABILITY",
        "ACCESSIBILITY_EFFECTIVENESS",
        "SATISFACTION",
        "ADOPTION"
      ]
    }
  },
  "$defs": {
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_status_code",
        "primary_status_text",
        "reason_code",
        "reason_text",
        "evidence_reference_ids",
        "safe_next_actions",
        "retry_allowed",
        "focus_target",
        "announcement_intent"
      ],
      "properties": {
        "primary_status_code": {
          "type": "string",
          "minLength": 1
        },
        "primary_status_text": {
          "type": "string",
          "minLength": 1
        },
        "reason_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_reference_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "safe_next_actions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "retry_allowed": {
          "type": "boolean"
        },
        "focus_target": {
          "type": [
            "string",
            "null"
          ]
        },
        "announcement_intent": {
          "enum": [
            "ASSERTIVE",
            "POLITE",
            "ALERT"
          ]
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "name",
        "role",
        "state",
        "focus_order",
        "reading_order"
      ],
      "properties": {
        "action_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "minLength": 1
        },
        "focus_order": {
          "type": "integer",
          "minimum": 0
        },
        "reading_order": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "affected_field",
        "action_id",
        "message"
      ],
      "properties": {
        "affected_field": {
          "type": "string",
          "minLength": 1
        },
        "action_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "location_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "label",
        "physical_location_id",
        "sequence_position",
        "order"
      ],
      "properties": {
        "row_id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "physical_location_id": {
          "type": "string",
          "minLength": 1
        },
        "sequence_position": {
          "type": "integer",
          "minimum": 1
        },
        "order": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
