{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "task_id",
    "included_files",
    "excluded_files",
    "estimated_tokens",
    "packet_sha256"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "included_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "excluded_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "estimated_tokens": {
      "type": "integer"
    },
    "packet_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
