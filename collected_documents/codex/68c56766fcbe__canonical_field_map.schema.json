{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["artifact_id", "schema_version", "global_invariants", "canonical_fields", "maps"],
  "properties": {
    "artifact_id": {"const": "RESEARCH-001-CANONICAL-FIELD-MAP"}, "schema_version": {"const": "2.0.0"},
    "global_invariants": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "canonical_fields": {"type": "array", "minItems": 10, "items": {"$ref": "#/$defs/canonical"}},
    "maps": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/map"}}
  },
  "$defs": {
    "canonical": {"type": "object", "additionalProperties": false, "required": ["field_id", "grain", "type", "nullable", "clock_role", "description"], "properties": {
      "field_id": {"type": "string", "minLength": 1}, "grain": {"type": "string", "minLength": 1}, "type": {"type": "string", "minLength": 1}, "nullable": {"type": "boolean"}, "clock_role": {"enum": ["none", "event", "effective", "publication", "observation", "retrieval"]}, "description": {"type": "string", "minLength": 1}
    }},
    "key": {"type": "object", "additionalProperties": false, "required": ["key_id", "grain", "components", "status"], "properties": {"key_id": {"type": "string"}, "grain": {"type": "string"}, "components": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "status": {"enum": ["authoritative", "candidate_only", "prohibited"]}}},
    "mapping": {"type": "object", "additionalProperties": false, "required": ["source_field", "source_type", "canonical_field_id", "semantic_role", "transform", "stage1_use", "grain_assertion", "notes"], "properties": {"source_field": {"type": "string"}, "source_type": {"type": "string"}, "canonical_field_id": {"type": "string"}, "semantic_role": {"type": "string"}, "transform": {"type": "string"}, "stage1_use": {"type": "string"}, "grain_assertion": {"type": "string"}, "notes": {"type": "string"}}},
    "map": {"type": "object", "additionalProperties": false, "required": ["source_id", "schema_families", "observation_key", "candidate_keys", "conflict_policy", "field_mappings", "sentinel_rules"], "properties": {
      "source_id": {"enum": ["ON-SELECT", "TOR-COA"]}, "schema_families": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
      "observation_key": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string"}}, "candidate_keys": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/key"}},
      "conflict_policy": {"type": "string", "minLength": 1}, "field_mappings": {"type": "array", "minItems": 10, "items": {"$ref": "#/$defs/mapping"}},
      "sentinel_rules": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["sentinel", "treatment"], "properties": {"sentinel": {"type": "string"}, "treatment": {"type": "string"}}}}
    }}
  }
}
