{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cre-foundry.local/schemas/autonomous-frontier-contract-v1.json",
  "title": "CRE Autonomous Frontier Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_id", "version", "mission_ref", "allowed_results", "capability_classes", "result_precedence", "gates"],
  "properties": {
    "contract_id": {"const": "CRE-AUTONOMOUS-FRONTIER"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "mission_ref": {"$ref": "#/$defs/relativePath"},
    "allowed_results": {"const": ["PASS", "FAIL", "BLOCKED_EXTERNAL"]},
    "capability_classes": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {"enum": ["repository_derivable", "publicly_researchable", "access_dependent", "human_authoritative", "empirically_measurable_only", "externally_hidden"]}
    },
    "result_precedence": {"const": ["FAIL", "BLOCKED_EXTERNAL", "PASS"]},
    "gates": {"type": "array", "minItems": 23, "items": {"$ref": "#/$defs/gate"}}
  },
  "$defs": {
    "relativePath": {"type": "string", "minLength": 1, "not": {"pattern": "^(?:/|.*(?:^|/)\\.\\.(?:/|$))"}},
    "proofLevel": {"type": "integer", "minimum": 0, "maximum": 9},
    "nonEmptyStrings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "path", "availability", "evidence_type", "minimum_proof_level", "sha256"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "path": {"$ref": "#/$defs/relativePath"},
        "availability": {"enum": ["autonomous", "external"]},
        "evidence_type": {"enum": ["specification", "deterministic_test", "differential_reference", "mutation_fault", "synthetic", "real_source_sample", "historical_point_in_time", "prospective_shadow", "randomized_prospective", "production_observed", "external_attestation"]},
        "minimum_proof_level": {"$ref": "#/$defs/proofLevel"},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "description", "availability", "minimum_proof_level", "artifact"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "availability": {"enum": ["autonomous", "external"]},
        "minimum_proof_level": {"$ref": "#/$defs/proofLevel"},
        "artifact": {"$ref": "#/$defs/relativePath"}
      }
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluator_id", "type", "owner", "independent_from_builder", "artifact"],
      "properties": {
        "evaluator_id": {"type": "string", "minLength": 1},
        "type": {"enum": ["public", "sealed", "external_hidden"]},
        "owner": {"type": "string", "minLength": 1},
        "independent_from_builder": {"type": "boolean"},
        "artifact": {"$ref": "#/$defs/relativePath"}
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command_id", "phase", "argv", "cwd", "timeout_seconds", "expected_exit_code", "expected_stdout"],
      "properties": {
        "command_id": {"type": "string", "minLength": 1},
        "phase": {"enum": ["autonomous", "external"]},
        "argv": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
        "cwd": {"$ref": "#/$defs/relativePath"},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 120},
        "expected_exit_code": {"type": "integer"},
        "expected_stdout": {"type": ["string", "null"]}
      }
    },
    "knownBad": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "description", "fixture", "verification_command_id", "expected_diagnostic"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "fixture": {"$ref": "#/$defs/relativePath"},
        "verification_command_id": {"type": "string", "minLength": 1},
        "expected_diagnostic": {"type": "string", "minLength": 1}
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "classification", "owner", "unlock_condition", "evidence_artifact"],
      "properties": {
        "gate_id": {"type": "string", "minLength": 1},
        "classification": {"enum": ["access_dependent", "human_authoritative", "empirically_measurable_only", "externally_hidden"]},
        "owner": {"type": "string", "minLength": 1},
        "unlock_condition": {"type": "string", "minLength": 1},
        "evidence_artifact": {"$ref": "#/$defs/relativePath"}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "domain", "decision_purpose", "dependencies", "pass_conditions", "failure_conditions", "required_artifacts", "required_evidence", "required_evaluator", "verification_commands", "known_bad_cases", "achieved_proof_level", "autonomous_required_proof_level", "required_proof_level", "claim_ceiling", "unresolved_uncertainty", "external_blocker"],
      "properties": {
        "gate_id": {"type": "string", "pattern": "^AF-[A-Z0-9]+(?:-[A-Z0-9]+)*-[0-9]{3}$"},
        "domain": {"type": "string", "minLength": 1},
        "decision_purpose": {"type": "string", "minLength": 1},
        "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^AF-[A-Z0-9]+(?:-[A-Z0-9]+)*-[0-9]{3}$"}},
        "pass_conditions": {"$ref": "#/$defs/nonEmptyStrings"},
        "failure_conditions": {"$ref": "#/$defs/nonEmptyStrings"},
        "required_artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
        "required_evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "required_evaluator": {"$ref": "#/$defs/evaluator"},
        "verification_commands": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/command"}},
        "known_bad_cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/knownBad"}},
        "achieved_proof_level": {"$ref": "#/$defs/proofLevel"},
        "autonomous_required_proof_level": {"$ref": "#/$defs/proofLevel"},
        "required_proof_level": {"$ref": "#/$defs/proofLevel"},
        "claim_ceiling": {"type": "string", "minLength": 1},
        "unresolved_uncertainty": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "external_blocker": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/blocker"}]}
      }
    }
  }
}
