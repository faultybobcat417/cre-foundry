{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "codex_found",
    "version",
    "commands",
    "recommended_mode",
    "gates"
  ],
  "properties": {
    "codex_found": {
      "type": "boolean"
    },
    "version": {
      "type": [
        "string",
        "null"
      ]
    },
    "commands": {
      "type": "object"
    },
    "recommended_mode": {
      "type": "string"
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
