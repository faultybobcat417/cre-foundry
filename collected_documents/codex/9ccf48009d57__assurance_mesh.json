{
  "config_version": "cre-foundry-assurance-mesh-v1",
  "policy": {
    "operating_mode": "shadow",
    "read_only_input_validation": true,
    "deterministic_double_build_required": true,
    "artifact_digest_continuity_required": true,
    "dependency_dag_required": true,
    "adversarial_scenario_matrix_required": true,
    "state_aware_invariants_required": true,
    "approval_invention_forbidden": true,
    "client_value_invention_forbidden": true,
    "executable_command_generation_enabled": false,
    "archive_generation_enabled": false,
    "database_access_enabled": false,
    "database_write_enabled": false,
    "snapshot_registration_enabled": false,
    "source_schedule_activation_enabled": false,
    "automatic_acquisition_enabled": false,
    "persistent_outcome_ledger_enabled": false,
    "outcome_event_insertion_enabled": false,
    "point_in_time_materialization_enabled": false,
    "model_training_enabled": false,
    "backtest_execution_enabled": false,
    "pilot_execution_enabled": false,
    "production_ranking_enabled": false,
    "outreach_enabled": false
  },
  "recommended_source_id": "brampton_building_permits",
  "artifact_nodes": [
    {
      "artifact_id": "governance_decisions",
      "path": "config/governance_decisions.json",
      "role": "human decision state",
      "required": true
    },
    {
      "artifact_id": "governance_approval_packets",
      "path": "docs/data_contracts/governance_approval_packet_template.json",
      "role": "checksum-bound source evidence",
      "required": true
    },
    {
      "artifact_id": "client_questionnaire",
      "path": "docs/data_contracts/client_input_questionnaire.json",
      "role": "authoritative client input schema",
      "required": true
    },
    {
      "artifact_id": "manual_decision_validation",
      "path": "docs/data_contracts/manual_decision_validation.json",
      "role": "decision validation output",
      "required": true
    },
    {
      "artifact_id": "manual_activation_summary",
      "path": "docs/data_contracts/manual_activation_envelope_summary.json",
      "role": "activation readiness state",
      "required": true
    },
    {
      "artifact_id": "historical_envelope",
      "path": "docs/data_contracts/historical_registration_execution_envelope.json",
      "role": "historical registration boundary",
      "required": true
    },
    {
      "artifact_id": "outcome_envelope",
      "path": "docs/data_contracts/outcome_ledger_bootstrap_envelope.json",
      "role": "outcome-ledger bootstrap boundary",
      "required": true
    },
    {
      "artifact_id": "codex_gate_graph",
      "path": "docs/data_contracts/codex_handoff_gate_graph.json",
      "role": "Codex readiness dependency graph",
      "required": true
    },
    {
      "artifact_id": "outcome_activation_template",
      "path": "docs/data_contracts/outcome_ledger_activation_request_template.json",
      "role": "outcome activation continuity anchor",
      "required": true
    },
    {
      "artifact_id": "outcome_contract",
      "path": "docs/data_contracts/outcome_collection_contract.json",
      "role": "outcome schema contract",
      "required": true
    },
    {
      "artifact_id": "codex_manifest",
      "path": "docs/data_contracts/codex_contract_bundle_manifest.json",
      "role": "future Codex artifact checksums",
      "required": true
    },
    {
      "artifact_id": "human_workbench_summary",
      "path": "docs/data_contracts/human_input_workbench_summary.json",
      "role": "human workbench continuity state",
      "required": true
    },
    {
      "artifact_id": "permit_review_workbook",
      "path": "docs/data_contracts/brampton_permit_review_workbook.json",
      "role": "named source review workbook",
      "required": true
    },
    {
      "artifact_id": "client_answer_workbook",
      "path": "docs/data_contracts/client_answer_workbook.json",
      "role": "client answer workbench",
      "required": true
    },
    {
      "artifact_id": "gate_command_templates",
      "path": "docs/data_contracts/gate_driven_command_templates.json",
      "role": "inert future command descriptions",
      "required": true
    }
  ],
  "dependency_edges": [
    {
      "from": "governance_approval_packets",
      "to": "governance_decisions"
    },
    {
      "from": "client_questionnaire",
      "to": "governance_decisions"
    },
    {
      "from": "governance_decisions",
      "to": "manual_decision_validation"
    },
    {
      "from": "manual_decision_validation",
      "to": "manual_activation_summary"
    },
    {
      "from": "manual_activation_summary",
      "to": "historical_envelope"
    },
    {
      "from": "manual_activation_summary",
      "to": "outcome_envelope"
    },
    {
      "from": "historical_envelope",
      "to": "codex_gate_graph"
    },
    {
      "from": "outcome_envelope",
      "to": "codex_gate_graph"
    },
    {
      "from": "governance_approval_packets",
      "to": "permit_review_workbook"
    },
    {
      "from": "client_questionnaire",
      "to": "client_answer_workbook"
    },
    {
      "from": "manual_activation_summary",
      "to": "human_workbench_summary"
    },
    {
      "from": "codex_gate_graph",
      "to": "codex_manifest"
    },
    {
      "from": "human_workbench_summary",
      "to": "gate_command_templates"
    }
  ]
}
