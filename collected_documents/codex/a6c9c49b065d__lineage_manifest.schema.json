{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cre-foundry.local/schemas/lineage-manifest-v1.json",
  "title": "CRE Foundry observability lineage manifest",
  "description": "Complete-path lineage, correlation, replay identity, and sensitive-log control for the representative route-day system. Every route decision must carry source public-availability/as-of identity, correlation ids, and complete lineage without emitting protected-account match details to general logs. Recursive-closed and intended to be judged by scripts/validate_observability_lineage.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_kind",
    "schema_version",
    "execution_scope",
    "decisions",
    "logs",
    "proof",
    "claim_ceiling"
  ],
  "properties": {
    "document_kind": { "const": "OBSERVABILITY_LINEAGE_MANIFEST" },
    "schema_version": { "const": "1.0.0" },
    "execution_scope": { "const": "SYNTHETIC_NON_INFLUENCING" },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "decision_id",
          "as_of",
          "source_public_availability",
          "lineage_nodes",
          "correlation_id"
        ],
        "properties": {
          "decision_id": { "type": "string" },
          "as_of": { "type": "string" },
          "source_public_availability": { "type": "string" },
          "lineage_nodes": {
            "type": "array",
            "items": { "type": "string" }
          },
          "correlation_id": { "type": "string" }
        }
      }
    },
    "logs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["level", "message", "payload"],
        "properties": {
          "level": { "type": "string" },
          "message": { "type": "string" },
          "payload": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "result"],
      "properties": {
        "level": { "const": 4 },
        "result": { "const": "PASS" }
      }
    },
    "claim_ceiling": { "type": "string" }
  }
}
