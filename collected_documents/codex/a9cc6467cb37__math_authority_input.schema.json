{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["artifact_id", "schema_version", "instructions", "eligible_inputs", "submission", "ingestion_status", "live_authority_granted"],
  "properties": {
    "artifact_id": {"const": "MATH-001-HUMAN-AUTHORITY-INPUT-TEMPLATE"}, "schema_version": {"const": "1.0.0"},
    "instructions": {"type": "string", "minLength": 1},
    "eligible_inputs": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": {"$ref": "#/$defs/input"}},
    "submission": {"$ref": "#/$defs/submission"}, "ingestion_status": {"const": "NOT_AN_INGESTION_INTERFACE"}, "live_authority_granted": {"const": false}
  },
  "$defs": {
    "input": {
      "type": "object", "additionalProperties": false, "required": ["input_id", "unit", "owner", "gate_id"],
      "properties": {"input_id": {"type": "string", "minLength": 1}, "unit": {"type": "string", "minLength": 1}, "owner": {"type": "string", "minLength": 1}, "gate_id": {"type": "string", "minLength": 1}}
    },
    "submission": {
      "type": "object", "additionalProperties": false,
      "required": ["input_id", "value", "issuer", "issued_at", "evidence_artifact", "artifact_sha256", "approval_scope"],
      "properties": {
        "input_id": {"type": "null"}, "value": {"type": "null"},
        "issuer": {"type": "null"}, "issued_at": {"type": "null"},
        "evidence_artifact": {"type": "null"}, "artifact_sha256": {"type": "null"},
        "approval_scope": {"type": "null"}
      }
    }
  }
}
