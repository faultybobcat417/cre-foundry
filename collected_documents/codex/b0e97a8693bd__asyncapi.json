  "components": {
    "messages": {
      "CloudEvent": {
        "name": "CloudEvent",
        "title": "Registered CRE domain event",
        "contentType": "application/cloudevents+json",
        "payload": {
          "$ref": "#/components/schemas/CloudEventEnvelope"
        },
        "correlationId": {
          "location": "$message.payload#/correlationid"
        }
      }
    },
    "schemas": {
      "CloudEventEnvelope": {
        "type": "object",
        "required": [
          "specversion",
          "id",
          "source",
          "type",
          "subject",
          "time",
          "datacontenttype",
          "dataschema",
          "correlationid",
          "causationid",
          "idempotencykey",
          "producer",
          "producer_version",
          "data"
        ],
        "properties": {
          "specversion": {
            "const": "1.0"
          },
          "id": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "pattern": "^cre\\."
          },
          "subject": {
            "type": "string"
          },
          "time": {
            "type": "string",
            "format": "date-time"
          },
          "datacontenttype": {
            "const": "application/json"
          },
          "dataschema": {
            "type": "string"
          },
          "correlationid": {
            "type": "string"
          },
          "causationid": {
            "type": "string"
          },
          "idempotencykey": {
            "type": "string"
          },
          "producer": {
            "type": "string"
          },
          "producer_version": {
            "type": "string"
          },
          "traceparent": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  }
