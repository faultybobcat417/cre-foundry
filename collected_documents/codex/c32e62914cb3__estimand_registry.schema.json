{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_id", "schema_version", "as_of", "input_states", "inputs", "estimands", "power_design", "power_result", "sensitivity_policy", "claim_ceiling"],
  "properties": {
    "artifact_id": {"const": "MATH-001-ESTIMAND-REGISTRY"},
    "schema_version": {"const": "1.1.0"},
    "as_of": {"type": "string", "format": "date"},
    "input_states": {"const": ["symbolic", "measured", "unknown", "human_authoritative"]},
    "inputs": {"type": "array", "minItems": 24, "maxItems": 24, "items": {"$ref": "#/$defs/input"}},
    "estimands": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/estimand"}},
    "power_design": {"$ref": "#/$defs/power_design"},
    "power_result": {"$ref": "#/$defs/power_result"},
    "sensitivity_policy": {"$ref": "#/$defs/sensitivity_policy"},
    "claim_ceiling": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "relative_path": {"type": "string", "minLength": 1, "not": {"pattern": "^(?:/|.*(?:^|/)\\.\\.(?:/|$))"}},
    "uncertainty": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "level", "lower", "upper"],
      "properties": {
        "method": {"type": "string", "minLength": 1}, "level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "lower": {"type": "number"}, "upper": {"type": "number"}
      }
    },
    "measurement": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "artifact", "artifact_sha256", "source_owner", "population", "window_start", "window_end", "sample_size", "estimator_id", "uncertainty", "proof_level"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1}, "artifact": {"$ref": "#/$defs/relative_path"},
        "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "source_owner": {"type": "string", "minLength": 1},
        "population": {"type": "string", "minLength": 1}, "window_start": {"type": "string", "format": "date-time"},
        "window_end": {"type": "string", "format": "date-time"}, "sample_size": {"type": "integer", "minimum": 1},
        "estimator_id": {"type": "string", "minLength": 1}, "uncertainty": {"$ref": "#/$defs/uncertainty"},
        "proof_level": {"type": "integer", "minimum": 2, "maximum": 8}
      }
    },
    "attestation": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "artifact", "artifact_sha256", "issuer", "issued_at", "subject_input_id", "proof_level"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1}, "artifact": {"$ref": "#/$defs/relative_path"},
        "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "issuer": {"type": "string", "minLength": 1},
        "issued_at": {"type": "string", "format": "date-time"}, "subject_input_id": {"type": "string", "minLength": 1},
        "proof_level": {"type": "integer", "minimum": 1, "maximum": 9}
      }
    },
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["input_id", "symbol", "state", "information_class", "unit", "value", "owner", "gate_id", "proof_level", "measurement", "authority_attestation", "sensitivity_set_ids"],
      "properties": {
        "input_id": {"type": "string", "minLength": 1}, "symbol": {"type": "string", "minLength": 1},
        "state": {"enum": ["symbolic", "unknown", "human_authoritative"]},
        "information_class": {"enum": ["CODEX_DERIVABLE", "PUBLICLY_RESEARCHABLE", "ACCESS_DEPENDENT", "HUMAN_AUTHORITATIVE", "EMPIRICAL_ONLY"]},
        "unit": {"type": "string", "minLength": 1}, "value": {"type": "null"}, "owner": {"type": ["string", "null"]},
        "gate_id": {"type": ["string", "null"]}, "proof_level": {"const": 0},
        "measurement": {"type": "null"},
        "authority_attestation": {"type": "null"},
        "sensitivity_set_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "allOf": [
        {"if": {"properties": {"state": {"enum": ["symbolic", "unknown"]}}}, "then": {"properties": {"value": {"type": "null"}, "proof_level": {"const": 0}, "measurement": {"type": "null"}, "authority_attestation": {"type": "null"}}}},
        {"if": {"properties": {"state": {"const": "measured"}}}, "then": {"properties": {"value": {"type": "number"}, "proof_level": {"minimum": 2}, "measurement": {"$ref": "#/$defs/measurement"}, "authority_attestation": {"type": "null"}}}},
        {"if": {"properties": {"state": {"const": "human_authoritative"}, "value": {"type": "null"}}}, "then": {"properties": {"proof_level": {"const": 0}, "measurement": {"type": "null"}, "authority_attestation": {"type": "null"}}}},
        {"if": {"properties": {"state": {"const": "human_authoritative"}, "value": {"type": "number"}}}, "then": {"properties": {"proof_level": {"minimum": 1}, "measurement": {"type": "null"}, "authority_attestation": {"$ref": "#/$defs/attestation"}}}}
      ]
    },
    "formula": {
      "type": "object", "additionalProperties": false,
      "required": ["expression_id", "expression", "symbols", "output_unit", "mode_rule"],
      "properties": {
        "expression_id": {"type": "string", "minLength": 1}, "expression": {"type": "string", "minLength": 1},
        "symbols": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "output_unit": {"type": "string", "minLength": 1}, "mode_rule": {"type": ["string", "null"]}
      }
    },
    "estimand": {
      "type": "object", "additionalProperties": false,
      "required": ["estimand_id", "decision_unit", "population", "treatment", "comparator", "outcome", "time_window", "aggregation", "scale", "formula", "required_proof_level", "current_status", "input_ids", "claim_ceiling"],
      "properties": {
        "estimand_id": {"enum": ["EST-F9-BASELINE-RATE", "EST-F9-BASELINE-VARIANCE", "EST-F9-ITT", "EST-PREDICTIVE-F9-RISK", "EST-POWER-SAMPLE-SIZE", "EST-RISK-ADJUSTED-NET-VALUE"]},
        "decision_unit": {"enum": ["representative_route_day", "candidate_physical_location_at_prediction_time"]}, "population": {"type": "string", "minLength": 1},
        "treatment": {"type": ["string", "null"]}, "comparator": {"type": ["string", "null"]},
        "outcome": {"type": "string", "minLength": 1}, "time_window": {"type": ["string", "null"]},
        "aggregation": {"type": "string", "minLength": 1}, "scale": {"type": "string", "minLength": 1},
        "formula": {"$ref": "#/$defs/formula"}, "required_proof_level": {"type": "integer", "minimum": 1, "maximum": 9},
        "current_status": {"enum": ["symbolic_only", "unknown_not_computable"]},
        "input_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "claim_ceiling": {"type": "string", "minLength": 1}
      }
    },
    "power_design": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "gate_id", "owner", "analysis_family", "sidedness", "multiplicity_policy", "randomization_unit", "estimator", "variance_model", "interference_representation"],
      "properties": {
        "state": {"const": "human_authoritative_unset"}, "gate_id": {"const": "GATE-EXPERIMENT-PROTOCOL-001"},
        "owner": {"const": "authorized experimental protocol owner"},
        "analysis_family": {"type": "null"}, "sidedness": {"type": "null"}, "multiplicity_policy": {"type": "null"},
        "randomization_unit": {"type": "null"}, "estimator": {"type": "null"}, "variance_model": {"type": "null"},
        "interference_representation": {"type": "null"}
      }
    },
    "power_result": {
      "type": "object", "additionalProperties": false,
      "required": ["estimate", "status", "reason", "unit", "input_ids", "proof_level", "evidence_refs"],
      "properties": {
        "estimate": {"type": "null"}, "status": {"const": "not_computable"},
        "reason": {"const": "required empirical and human-authoritative inputs are unset"}, "unit": {"const": "representative_route_days"},
        "input_ids": {"type": "array", "minItems": 13, "maxItems": 13, "uniqueItems": true, "items": {"type": "string"}},
        "proof_level": {"const": 0},
        "evidence_refs": {"type": "array", "maxItems": 0}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "not_computable"}}}, "then": {"properties": {"estimate": {"type": "null"}, "proof_level": {"const": 0}, "evidence_refs": {"maxItems": 0}}}},
        {"if": {"properties": {"status": {"enum": ["computed", "sensitivity_only"]}}}, "then": {"properties": {"estimate": {"type": "number"}, "proof_level": {"minimum": 1}, "evidence_refs": {"minItems": 1}}}}
      ]
    },
    "sensitivity_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["sets", "scenario_values_are_evidence", "maximum_proof_level", "required_output_label"],
      "properties": {
        "sets": {"type": "array", "maxItems": 0, "items": {"$ref": "#/$defs/sensitivity_set"}},
        "scenario_values_are_evidence": {"const": false}, "maximum_proof_level": {"const": 4},
        "required_output_label": {"const": "sensitivity_only_not_measured"}
      }
    },
    "sensitivity_set": {
      "type": "object", "additionalProperties": false,
      "required": ["sensitivity_set_id", "input_id", "unit", "values", "source_type", "justification", "output_label", "proof_level"],
      "properties": {
        "sensitivity_set_id": {"type": "string", "minLength": 1}, "input_id": {"type": "string", "minLength": 1},
        "unit": {"type": "string", "minLength": 1}, "values": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "number"}},
        "source_type": {"const": "symbolic_scenario"}, "justification": {"type": "string", "minLength": 1},
        "output_label": {"const": "sensitivity_only_not_measured"}, "proof_level": {"type": "integer", "minimum": 1, "maximum": 4}
      }
    }
  }
}
