  "identity_rules": [
    "Address equality alone never proves business identity, occupier identity or ownership.",
    "Every match stores method, score, evidence, conflict state and valid-time interval.",
    "Legal entity, operating business, brand, establishment and location remain separate identifiers.",
    "Move, rename, amalgamation, dissolution and identifier-reissue events preserve predecessor/successor lineage.",
    "Entity conflicts block live ranking when they could target the wrong protected account or physical place."
  ],
  "minimum_live_audit_requirements": {
    "precision_lower_bound": 0.95,
    "conflict_recall_target": 0.95,
    "stratification": [
      "municipality",
      "sector",
      "match_method",
      "multi_tenant",
      "address_change"
    ],
