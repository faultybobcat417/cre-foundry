{
  "ontology_version": "cre-entity-relationship-ontology-v2",
  "nodes": [
    {
      "node_type": "legal_entity",
      "definition": "Registered corporation, partnership or other legal person."
    },
    {
      "node_type": "operating_business",
      "definition": "Commercial operation that may span legal entities or brands."
    },
    {
      "node_type": "brand",
      "definition": "Public-facing commercial identity."
    },
    {
      "node_type": "establishment",
      "definition": "Operating unit performing activity at a physical location."
    },
    {
      "node_type": "business_location",
      "definition": "Standardized visitable physical place."
    },
    {
      "node_type": "address",
      "definition": "Postal/civic address representation with temporal validity."
    },
    {
      "node_type": "building",
      "definition": "Physical structure at an address or parcel."
    },
    {
      "node_type": "property",
      "definition": "Commercial real-estate asset or assessment unit."
    },
    {
      "node_type": "parcel",
      "definition": "Cadastral land unit."
    },
    {
      "node_type": "property_owner",
      "definition": "Legal or beneficial owner where lawfully observable."
    },
    {
      "node_type": "occupier",
      "definition": "Business or entity occupying all or part of a property."
    },
    {
      "node_type": "parent_organization",
      "definition": "Controlling or affiliated organization."
    },
    {
      "node_type": "permit",
      "definition": "Building or operating permission record."
    },
    {
      "node_type": "planning_application",
      "definition": "Planning, site-plan, variance or development application."
    },
    {
      "node_type": "licence",
      "definition": "Business, regulatory or facility licence."
    },
    {
      "node_type": "environmental_permission",
      "definition": "ECA/EASR or related permission."
    },
    {
      "node_type": "contract_award",
      "definition": "Public procurement award or contract."
    },
    {
      "node_type": "grant_contribution",
      "definition": "Public funding or contribution."
    },
    {
      "node_type": "job_posting",
      "definition": "Observed hiring demand record."
    },
    {
      "node_type": "importer_record",
      "definition": "Product-specific importer evidence."
    },
    {
      "node_type": "inspection_enforcement",
      "definition": "Inspection, suspension, cancellation or enforcement record."
    },
    {
      "node_type": "source_record",
      "definition": "Immutable raw or normalized record with provenance."
    },
    {
      "node_type": "evidence_bundle",
      "definition": "Point-in-time set of records supporting a feature or event."
    },
    {
      "node_type": "event",
      "definition": "Adjudicated real-world business or CRE event."
    },
    {
      "node_type": "opportunity",
      "definition": "Brokerage-capturable service need at a decision time."
    },
    {
      "node_type": "recommendation",
      "definition": "Tip Sheet selection and visit objective."
    },
    {
      "node_type": "field_contact",
      "definition": "Observed visit/contact attempt."
    },
    {
      "node_type": "outcome",
      "definition": "Mature or censored field and commercial result."
    }
