{
  "version": "2.0",
  "states": [
    "ACTIVE",
    "CONSULT",
    "NOT_APPLICABLE"
  ],
  "default_limits": {
    "parallel_read_reviewers": 3,
    "write_agents_per_worktree": 1,
    "high_consequence_parallel_reviewers": 5
  },
  "always": [
    "orchestrator",
    "verifier"
  ],
  "activate_rules": [
    {
      "domain": "cre_strategy",
      "when": [
        "candidate meaning",
        "mechanism",
        "field action",
        "commercial outcome"
      ]
    },
    {
      "domain": "source_intelligence",
      "when": [
        "external source",
        "acquisition",
        "licence",
        "schema",
        "latency"
      ]
    },
    {
      "domain": "identity_temporal",
      "when": [
        "entity",
        "address",
        "location",
        "history",
        "protected account"
      ]
    },
    {
      "domain": "statistics_probability",
      "when": [
        "rate",
        "uncertainty",
        "calibration",
        "censoring",
        "sample"
      ]
    },
    {
      "domain": "causal_experiment",
      "when": [
        "incremental lift",
        "randomization",
        "interference",
        "power"
      ]
    },
    {
      "domain": "machine_learning",
      "when": [
        "feature",
        "label",
        "model",
        "drift",
        "promotion"
      ]
    },
    {
      "domain": "optimization_physics",
      "when": [
        "route",
        "distance",
        "time",
        "capacity",
        "service uncertainty"
      ]
    },
    {
      "domain": "economics",
      "when": [
        "expected value",
        "commission",
        "cost",
        "commercial priority"
      ]
    },
    {
      "domain": "field_operations",
      "when": [
        "representative workflow",
        "visit",
        "access",
        "substitution"
      ]
    },
    {
      "domain": "software_architecture",
      "when": [
        "module",
        "API",
        "event",
        "database",
        "migration"
      ]
    },
    {
      "domain": "security_governance",
      "when": [
        "credential",
        "permission",
        "privacy",
        "external effect",
        "source terms"
      ]
    },
    {
      "domain": "reliability_observability",
      "when": [
        "SLO",
        "trace",
        "replay",
        "incident",
        "recovery"
      ]
    },
    {
      "domain": "product_ux",
      "when": [
        "representative UI",
        "form",
        "explanation",
        "mobile workflow"
      ]
    },
    {
      "domain": "testing_verification",
      "when": [
        "every material change"
      ]
    },
    {
      "domain": "research_methods",
      "when": [
        "material unknown or external claim"
      ]
    }
  ],
  "closure_rule": "Every plausible domain must have a recorded state and reason before milestone closure; only ACTIVE domains load full detail."
}
