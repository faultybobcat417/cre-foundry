{
  "version": "2.0",
  "primitives": [
    {
      "type": "OBJECTIVE",
      "required": [
        "id",
        "outcome",
        "measurement",
        "scope",
        "horizon"
      ],
      "purpose": "Defines the result to optimize without prescribing a weak implementation."
    },
    {
      "type": "INVARIANT",
      "required": [
        "id",
        "rule",
        "failure_effect",
        "authority"
      ],
      "purpose": "Defines a non-tradeable boundary."
    },
    {
      "type": "CLAIM",
      "required": [
        "id",
        "statement",
        "classification",
        "evidence_ids",
        "proof_level",
        "valid_time"
      ],
      "classification": [
        "fact",
        "inference",
        "assumption",
        "hypothesis",
        "unknown"
      ],
      "purpose": "Prevents unsupported statements from becoming project truth."
    },
    {
      "type": "QUESTION",
      "required": [
        "id",
        "decision_affected",
        "expected_information_value",
        "answerability",
        "owner"
      ],
      "purpose": "Focuses research on unknowns that can change decisions."
    },
    {
      "type": "EVIDENCE",
      "required": [
        "id",
        "source",
        "publication_time",
        "retrieval_time",
        "content_hash",
        "admissible_use"
      ],
      "purpose": "Preserves provenance and temporal availability."
    },
    {
      "type": "TASK",
      "required": [
        "id",
        "objective",
        "dependencies",
        "gates",
        "context_paths",
        "evaluator",
        "acceptance",
        "rollback"
      ],
      "purpose": "Creates an issue-quality executable work unit."
    },
    {
      "type": "DECISION",
      "required": [
        "id",
        "alternatives",
        "criteria",
        "selected",
        "evidence",
        "reversibility",
        "rollback"
      ],
      "purpose": "Preserves why a path was chosen and prevents repeated failed debate."
    },
    {
      "type": "EVALUATION",
      "required": [
        "id",
        "claim",
        "public_checks",
        "sealed_checks",
        "required_proof",
        "result"
      ],
      "purpose": "Defines what proves improvement."
    },
    {
      "type": "ARTIFACT",
      "required": [
        "id",
        "type",
        "path_or_uri",
        "content_hash",
        "producer",
        "lineage"
      ],
      "purpose": "Makes work durable and replayable."
    },
    {
      "type": "GATE",
      "required": [
        "id",
        "missing_authority_or_evidence",
        "owner",
        "unlock_action",
        "affected_tasks"
      ],
      "purpose": "Replaces fabricated information with a precise unblock path."
    },
    {
      "type": "STATE_TRANSITION",
      "required": [
        "entity",
        "from",
        "to",
        "actor",
        "reason",
        "evidence",
        "idempotency_key"
      ],
      "purpose": "Prevents silent or out-of-order project state changes."
    }
  ]
}
