{
  "openapi": "3.2.0",
  "info": {
    "title": "CRE Tip Sheet Internal Control API",
    "version": "0.12.0",
    "description": "Contract-first internal API. Mutations require idempotency and do not authorize live effects without a separate governance decision."
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "local/pilot placeholder"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Health and dependency state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/source-snapshots": {
      "post": {
        "operationId": "requestSourceSnapshot",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SourceSnapshotRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Snapshot request accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AcceptedOperation"
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/v1/source-snapshots/{snapshot_id}": {
      "get": {
        "operationId": "getSourceSnapshot",
        "parameters": [
          {
            "name": "snapshot_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Snapshot state and artifact references",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArtifactState"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/v1/entity-resolution/jobs": {
      "post": {
        "operationId": "requestEntityResolution",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EntityResolutionRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Resolution job accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AcceptedOperation"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/v1/candidate-universes": {
      "post": {
        "operationId": "freezeCandidateUniverse",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CandidateUniverseRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Candidate universe frozen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArtifactState"
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/v1/score-snapshots": {
      "post": {
        "operationId": "createScoreSnapshot",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScoreSnapshotRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Scores created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArtifactState"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/v1/daily-lists/plan": {
      "post": {
        "operationId": "planDailyList",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DailyListPlanRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Exactly ten plan or explicit abstention",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DailyListPlanResponse"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/v1/routes/{route_manifest_id}/issue": {
      "post": {
        "operationId": "issueRouteManifest",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "name": "route_manifest_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RouteIssueRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Route issued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArtifactState"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    },
    "/v1/field-visits": {
      "post": {
        "operationId": "recordFieldVisit",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FieldVisitRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Visit event recorded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArtifactState"
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/v1/outcomes": {
      "post": {
        "operationId": "recordOutcome",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OutcomeRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Outcome recorded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArtifactState"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/v1/decisions/{decision_id}/replay": {
      "post": {
        "operationId": "replayDecision",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "name": "decision_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Replay completed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReplayResponse"
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    },
    "/v1/governance/authorize": {
      "post": {
        "operationId": "authorizeAction",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthorizationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Allow, deny, hold, escalate or rollback",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthorizationResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 16,
          "maxLength": 200
        }
      }
    },
    "responses": {
      "Conflict": {
        "description": "State or idempotency conflict",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "ValidationError": {
        "description": "Contract validation failed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Authorization denied",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message",
          "correlation_id"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "correlation_id": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      },
      "ArtifactReference": {
        "type": "object",
        "required": [
          "artifact_id",
          "artifact_type",
          "content_sha256"
        ],
        "properties": {
          "artifact_id": {
            "type": "string"
          },
          "artifact_type": {
            "type": "string"
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "uri": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "HealthResponse": {
        "type": "object",
        "required": [
          "status",
          "time",
          "dependencies"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "healthy",
              "degraded",
              "unhealthy"
            ]
          },
          "time": {
            "type": "string",
            "format": "date-time"
          },
          "dependencies": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "AcceptedOperation": {
        "type": "object",
        "required": [
          "operation_id",
          "state",
          "correlation_id"
        ],
        "properties": {
          "operation_id": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "queued",
              "accepted"
            ]
          },
          "correlation_id": {
            "type": "string"
          }
        }
      },
      "ArtifactState": {
        "type": "object",
        "required": [
          "state",
          "artifact",
          "correlation_id"
        ],
        "properties": {
          "state": {
            "type": "string"
          },
          "artifact": {
            "$ref": "#/components/schemas/ArtifactReference"
          },
          "correlation_id": {
            "type": "string"
          }
        }
      },
      "SourceSnapshotRequest": {
        "type": "object",
        "required": [
          "source_id",
          "retrieval_cutoff_utc",
          "approval_reference"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "retrieval_cutoff_utc": {
            "type": "string",
            "format": "date-time"
          },
          "approval_reference": {
            "type": "string"
          },
          "request_parameters": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      },
      "EntityResolutionRequest": {
        "type": "object",
        "required": [
          "normalized_product_ids",
          "resolution_policy_version"
        ],
        "properties": {
          "normalized_product_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "resolution_policy_version": {
            "type": "string"
          }
        }
      },
      "CandidateUniverseRequest": {
        "type": "object",
        "required": [
          "prediction_time_utc",
          "entity_graph_snapshot_id",
          "protection_snapshot_id"
        ],
        "properties": {
          "prediction_time_utc": {
            "type": "string",
            "format": "date-time"
          },
          "entity_graph_snapshot_id": {
            "type": "string"
          },
          "protection_snapshot_id": {
            "type": "string"
          }
        }
      },
      "ScoreSnapshotRequest": {
        "type": "object",
        "required": [
          "candidate_universe_snapshot_id",
          "feature_snapshot_id",
          "model_version_id"
        ],
        "properties": {
          "candidate_universe_snapshot_id": {
            "type": "string"
          },
          "feature_snapshot_id": {
            "type": "string"
          },
          "model_version_id": {
            "type": "string"
          }
        }
      },
      "DailyListPlanRequest": {
        "type": "object",
        "required": [
          "score_snapshot_id",
          "representative_id",
          "shift_date",
          "policy_version"
        ],
        "properties": {
          "score_snapshot_id": {
            "type": "string"
          },
          "representative_id": {
            "type": "string"
          },
          "shift_date": {
            "type": "string",
            "format": "date"
          },
          "policy_version": {
            "type": "string"
          }
        }
      },
      "DailyListPlanResponse": {
        "type": "object",
        "required": [
          "decision",
          "correlation_id"
        ],
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "planned_exactly_ten",
              "abstain_no_valid_ten"
            ]
          },
          "daily_list_plan": {
            "$ref": "#/components/schemas/ArtifactReference"
          },
          "correlation_id": {
            "type": "string"
          }
        }
      },
      "RouteIssueRequest": {
        "type": "object",
        "required": [
          "authorization_decision_id",
          "representative_id"
        ],
        "properties": {
          "authorization_decision_id": {
            "type": "string"
          },
          "representative_id": {
            "type": "string"
          }
        }
      },
      "FieldVisitRequest": {
        "type": "object",
        "required": [
          "route_manifest_id",
          "business_location_id",
          "event_time_utc",
          "visit_state"
        ],
        "properties": {
          "route_manifest_id": {
            "type": "string"
          },
          "business_location_id": {
            "type": "string"
          },
          "event_time_utc": {
            "type": "string",
            "format": "date-time"
          },
          "visit_state": {
            "type": "string",
            "enum": [
              "visited",
              "skipped",
              "substituted"
            ]
          },
          "structured_answers": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "OutcomeRequest": {
        "type": "object",
        "required": [
          "business_location_id",
          "event_time_utc",
          "outcome_type",
          "evidence_reference"
        ],
        "properties": {
          "business_location_id": {
            "type": "string"
          },
          "event_time_utc": {
            "type": "string",
            "format": "date-time"
          },
          "outcome_type": {
            "type": "string",
            "enum": [
              "f9_booked",
              "attended",
              "qualified_requirement",
              "mandate",
              "transaction",
              "commission"
            ]
          },
          "evidence_reference": {
            "type": "string"
          }
        }
      },
      "ReplayResponse": {
        "type": "object",
        "required": [
          "decision_id",
          "match",
          "replay_bundle"
        ],
        "properties": {
          "decision_id": {
            "type": "string"
          },
          "match": {
            "type": "boolean"
          },
          "replay_bundle": {
            "$ref": "#/components/schemas/ArtifactReference"
          }
        }
      },
      "AuthorizationRequest": {
        "type": "object",
        "required": [
          "capability",
          "action_hash",
          "policy_hashes",
          "delegation_reference"
        ],
        "properties": {
          "capability": {
            "type": "string"
          },
          "action_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "policy_hashes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "delegation_reference": {
            "type": "string"
          }
        }
      },
      "AuthorizationResponse": {
        "type": "object",
        "required": [
          "decision",
          "authorization_decision_id",
          "correlation_id"
        ],
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "allow",
              "deny",
              "hold",
              "escalate",
              "rollback"
            ]
          },
          "authorization_decision_id": {
            "type": "string"
          },
          "correlation_id": {
            "type": "string"
          },
          "reason_codes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
