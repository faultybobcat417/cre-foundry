{
  "contract_version": "cre-pilot-cross-source-join-v1",
  "pilot_geography": [
    "Brampton",
    "Mississauga"
  ],
  "join_stages": [
    {
      "stage": 1,
      "name": "address_normalization",
      "inputs": [
        "street number",
        "street name",
        "unit",
        "postal code",
        "coordinates"
      ],
      "outputs": [
        "canonical_address_id",
        "address_confidence"
      ],
      "hard_rules": [
        "unit is never dropped for multi-tenant locations",
        "postal mismatch is retained as conflict",
        "geocode distance thresholds vary by property type"
      ]
    },
    {
      "stage": 2,
      "name": "establishment_identity",
      "inputs": [
        "business name",
        "PIN/source ID",
        "NAICS",
        "phone domain/web domain",
        "address history"
      ],
      "outputs": [
        "establishment_id",
        "match_score",
        "conflict_group"
      ],
      "hard_rules": [
        "name+address alone cannot merge legal entities",
        "one source PIN is source-scoped, not universal",
        "voluntary directory absence is not death"
      ]
    },
    {
      "stage": 3,
      "name": "permit_to_location",
      "inputs": [
        "permit address",
        "unit",
        "applicant/builder/contractor",
        "permit work text",
        "coordinates"
      ],
      "outputs": [
        "business_location_id",
        "occupier_link_state",
        "landlord_or_tenant_work_probability"
      ],
      "hard_rules": [
        "permit-address match does not prove occupier",
        "builder/contractor is not tenant",
        "speculative landlord work remains counterevidence"
      ]
    },
    {
      "stage": 4,
      "name": "federal_entity_link",
      "inputs": [
        "supplier/recipient/employer/company name",
        "city",
        "postal",
        "business number/company ID when present"
      ],
      "outputs": [
        "legal_entity_id",
        "operating_business_id",
        "location_link_state"
      ],
      "hard_rules": [
        "recipient city is not funded-site proof",
        "supplier address is not delivery-site proof",
        "fuzzy-only matches cannot promote live candidates"
      ]
    },
    {
      "stage": 5,
      "name": "temporal_lineage",
      "inputs": [
        "2019 directory",
        "2024 directory",
        "2025 directory",
        "monthly/quarterly federal vintages"
      ],
      "outputs": [
        "first_seen",
        "last_seen",
        "predecessor_successor",
        "move_branch_or_participation_state"
      ],
      "hard_rules": [
        "appearance/disappearance requires competing explanations",
        "annual gaps are interval-censored",
        "schema-specific missing fields are not business changes"
      ]
    }
  ],
  "match_decision_classes": [
    "deterministic_verified",
    "high_confidence_reviewed",
    "probabilistic_research_only",
    "conflicted",
    "unmatched"
  ],
  "live_requirements": {
    "deterministic_or_reviewed_precision_lcb": 0.95,
    "protected_account_false_clear_tolerance": 0.0,
    "permit_occupier_link_requires_independent_evidence": true,
    "fuzzy_only_live_use": false
  },
  "audit_strata": [
    "municipality",
    "NAICS family",
    "multi-tenant",
    "address change",
    "common business name",
    "federal-source match",
    "permit text availability"
  ],
  "negative_controls": [
    "same-name different-address firms",
    "same-address different-unit firms",
    "builder/contractor mistaken for occupier",
    "voluntary-directory disappearance",
    "postal-code typo",
    "corporate registered office without operating site"
  ]
}
