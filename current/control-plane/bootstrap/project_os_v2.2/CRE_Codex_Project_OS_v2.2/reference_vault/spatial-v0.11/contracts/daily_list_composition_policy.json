{
  "policy_version": "cre-daily-list-composition-v1",
  "route_size": 10,
  "primary_delivery": "exactly_10_or_abstain",
  "selection_layers": [
    "protected_account_and_eligibility_filter",
    "point_in_time_business_value_estimation",
    "spatial_pod_generation",
    "portfolio_composition",
    "compactness_optimization",
    "route_sequence_and_robustness",
    "manifest_and_replay"
  ],
  "default_composition_research_arm": {
    "high_confidence_exploitation": 7,
    "independent_mechanism_or_sector_diversity": 2,
    "bounded_exploration": 1,
    "status": "research_default_not_production_truth"
  },
  "composition_constraints": {
    "maximum_same_parent_or_legal_group": 1,
    "maximum_same_property": 2,
    "maximum_same_industrial_complex": 4,
    "minimum_distinct_mechanism_families": 2,
    "minimum_distinct_business_families": 2,
    "maximum_unreviewed_probabilistic_entity_links": 0,
    "maximum_high_uncertainty_exploration": 1
  },
  "concentration_exceptions": {
    "multi_tenant_campaign_allowed": true,
    "requirements": [
      "approved campaign purpose",
      "separate decision makers",
      "protected-account clearance",
      "property-level contact-frequency clearance",
      "experiment contamination recorded"
    ]
  },
  "reserve_pool": {
    "size": 5,
    "visible_as_primary_tip_sheet_locations": false,
    "counts_toward_exact_ten": false,
    "purpose": "logged substitution after access, closure or safety failure",
    "selection_rule": "same spatial pod and closest admissible composition match",
    "substitution_requires": [
      "registered failure reason",
      "pre-contact substitution timestamp",
      "new manifest hash",
      "treatment and analysis flag"
    ]
  },
  "abstention_conditions": [
    "fewer_than_ten_eligible_locations",
    "business_value_floor_cannot_be_met",
    "shift_feasibility_fails",
    "protected_account_or_entity_conflict_unresolved",
    "source_or_route_matrix_health_fails",
    "composition_constraints_cannot_be_satisfied_without_unsafe_relaxation"
  ],
  "comparison_arms": [
    "value_only_top_ten",
    "value_floor_then_compactness",
    "seven_two_one_portfolio",
    "single_spatial_pod",
    "incumbent_representative_selection",
    "stratified_random_eligible"
  ],
  "promotion_rule": "No composition policy promotes until it improves the registered route-day objective without material loss of business value, adherence or causal identifiability."
}
