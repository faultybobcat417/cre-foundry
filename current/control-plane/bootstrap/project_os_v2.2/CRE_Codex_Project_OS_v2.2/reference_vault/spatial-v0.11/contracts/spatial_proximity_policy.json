{
  "policy_version": "cre-spatial-proximity-policy-v1",
  "as_of": "2026-08-01",
  "business_rule": "Vehicle ownership and energy cost are not material ranking penalties. Spatial coherence remains a secondary objective because representative time, completion probability, local learning and daily execution matter.",
  "optimization_order": [
    "eligibility_protection_and_exactly_ten",
    "expected_incremental_business_value",
    "minimum_business_value_retention",
    "portfolio_and_experiment_constraints",
    "spatial_compactness",
    "visit_sequence"
  ],
  "business_value_retention_floor": 0.95,
  "proximity_role": "epsilon_constrained_secondary_objective",
  "distance_cost_components": {
    "vehicle_energy_cost_weight": 0.0,
    "vehicle_depreciation_cost_weight": 0.0,
    "representative_time_weight": 1.0,
    "completion_probability_weight": 1.0,
    "local_learning_weight": 0.5,
    "territory_consistency_weight": 0.5
  },
  "spatial_metrics": [
    "total_route_duration",
    "approximate_route_distance",
    "maximum_single_leg_duration",
    "mean_distance_to_medoid",
    "maximum_distance_to_medoid",
    "median_pairwise_distance",
    "h3_cell_count",
    "industrial_cluster_count"
  ],
  "provider_hierarchy": [
    {
      "provider": "cached_authorized_route_matrix",
      "use": "production and replay",
      "priority": 1
    },
    {
      "provider": "google_routes_compute_route_matrix",
      "use": "authorized production or canary",
      "priority": 2
    },
    {
      "provider": "self_hosted_osrm_table",
      "use": "lower-cost authorized matrix fallback",
      "priority": 3
    },
    {
      "provider": "haversine_distance",
      "use": "offline planning and fail-closed approximation",
      "priority": 4
    }
  ],
  "spatial_index": {
    "preferred": "H3",
    "purposes": [
      "candidate partitioning",
      "neighbour search",
      "persistent spatial pods",
      "experiment blocking",
      "coverage diagnostics"
    ],
    "resolution": "calibrated_from_real_candidate_density",
    "hardcoded_resolution_forbidden": true
  },
  "feasibility": {
    "hard_distance_cap_km": null,
    "hard_drive_time_cap_minutes": null,
    "rule": "No arbitrary vehicle-distance cap. The hard constraint is that ten visits remain feasible inside the representative shift after service, access and uncertainty buffers.",
    "uncertainty_buffer": "calibrated_from_observed_route_and_service_time"
  },
  "exception_rule": {
    "allow_distant_high_value_candidate": true,
    "maximum_exceptional_outliers": 1,
    "required_incremental_value_gain": "must exceed the registered practical-value threshold and preserve route-day completion feasibility"
  },
  "claim_boundary": "Initial retention and composition parameters are planning defaults. They require historical and field calibration."
}
