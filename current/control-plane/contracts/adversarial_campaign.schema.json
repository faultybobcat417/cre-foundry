{
  "$id": "https://cre-foundry.local/schemas/adversarial-connected-campaign-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "campaign_id": {
      "const": "ADVERSARIAL-001-CONNECTED-CAMPAIGN"
    },
    "claim_ceiling": {
      "const": "Synthetic ADVERSARIAL-001 conformance only; no sealed evaluator, hidden holdout, live penetration test, external workflow, field performance, or production claim."
    },
    "evaluator_available": {
      "type": "boolean"
    },
    "evaluator_weakened": {
      "type": "boolean"
    },
    "execution_scope": {
      "const": "SYNTHETIC_NON_INFLUENCING"
    },
    "external_effect_occurred": {
      "const": false
    },
    "faults": {
      "additionalProperties": false,
      "properties": {
        "duplicate_effect": {
          "type": "boolean"
        },
        "idempotent_retry": {
          "type": "boolean"
        },
        "partial_state_accepted": {
          "type": "boolean"
        }
      },
      "required": [
        "idempotent_retry",
        "duplicate_effect",
        "partial_state_accepted"
      ],
      "type": "object"
    },
    "identity": {
      "additionalProperties": false,
      "properties": {
        "ambiguous": {
          "type": "boolean"
        },
        "cleared": {
          "type": "boolean"
        },
        "protected": {
          "type": "boolean"
        }
      },
      "required": [
        "protected",
        "ambiguous",
        "cleared"
      ],
      "type": "object"
    },
    "input_validation": {
      "additionalProperties": false,
      "properties": {
        "duplicate_keys_rejected": {
          "type": "boolean"
        },
        "malformed_rejected": {
          "type": "boolean"
        }
      },
      "required": [
        "malformed_rejected",
        "duplicate_keys_rejected"
      ],
      "type": "object"
    },
    "live_permissions": {
      "const": false
    },
    "outcomes": {
      "additionalProperties": false,
      "properties": {
        "attribution_bound": {
          "type": "boolean"
        },
        "booking_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "economics_bound": {
          "type": "boolean"
        },
        "unique_booking_count": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "booking_ids",
        "unique_booking_count",
        "attribution_bound",
        "economics_bound"
      ],
      "type": "object"
    },
    "proof_level": {
      "const": 4
    },
    "properties": {
      "additionalProperties": false,
      "properties": {
        "hard_invariant_survivors": {
          "items": {
            "type": "string"
          },
          "maxItems": 0,
          "type": "array"
        },
        "permutation_invariant": {
          "type": "boolean"
        },
        "protection_monotonic": {
          "type": "boolean"
        },
        "replay_stable": {
          "type": "boolean"
        }
      },
      "required": [
        "permutation_invariant",
        "replay_stable",
        "protection_monotonic",
        "hard_invariant_survivors"
      ],
      "type": "object"
    },
    "recovery": {
      "additionalProperties": false,
      "properties": {
        "backup_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "prior_version": {
          "minLength": 1,
          "type": "string"
        },
        "restore_verified": {
          "type": "boolean"
        },
        "restored_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "restored_version": {
          "minLength": 1,
          "type": "string"
        },
        "rollback_verified": {
          "type": "boolean"
        }
      },
      "required": [
        "restore_verified",
        "rollback_verified",
        "backup_sha256",
        "restored_sha256",
        "prior_version",
        "restored_version"
      ],
      "type": "object"
    },
    "route": {
      "additionalProperties": false,
      "properties": {
        "protected_stop_count": {
          "minimum": 0,
          "type": "integer"
        },
        "stop_count": {
          "minimum": 0,
          "type": "integer"
        },
        "unique_location_count": {
          "minimum": 0,
          "type": "integer"
        },
        "within_budget": {
          "type": "boolean"
        }
      },
      "required": [
        "stop_count",
        "unique_location_count",
        "protected_stop_count",
        "within_budget"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "security": {
      "additionalProperties": false,
      "properties": {
        "authorization_bypass": {
          "type": "boolean"
        },
        "protected_detail_disclosed": {
          "type": "boolean"
        },
        "sensitive_general_log": {
          "type": "boolean"
        }
      },
      "required": [
        "sensitive_general_log",
        "authorization_bypass",
        "protected_detail_disclosed"
      ],
      "type": "object"
    },
    "source": {
      "additionalProperties": false,
      "properties": {
        "decision_as_of": {
          "minLength": 1,
          "type": "string"
        },
        "immutable_snapshot": {
          "type": "boolean"
        },
        "snapshot_current": {
          "type": "boolean"
        },
        "source_as_of": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "immutable_snapshot",
        "snapshot_current",
        "source_as_of",
        "decision_as_of"
      ],
      "type": "object"
    },
    "temporal": {
      "additionalProperties": false,
      "properties": {
        "decision_time": {
          "minLength": 1,
          "type": "string"
        },
        "future_feature_used": {
          "type": "boolean"
        },
        "maximum_feature_time": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "decision_time",
        "maximum_feature_time",
        "future_feature_used"
      ],
      "type": "object"
    },
    "uncertainty": {
      "additionalProperties": false,
      "properties": {
        "abstain_threshold": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "abstention_required": {
          "type": "boolean"
        },
        "issued": {
          "type": "boolean"
        },
        "uncertainty_score": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "uncertainty_score",
        "abstain_threshold",
        "abstention_required",
        "issued"
      ],
      "type": "object"
    }
  },
  "required": [
    "campaign_id",
    "schema_version",
    "execution_scope",
    "proof_level",
    "live_permissions",
    "external_effect_occurred",
    "evaluator_available",
    "evaluator_weakened",
    "input_validation",
    "temporal",
    "source",
    "identity",
    "uncertainty",
    "route",
    "outcomes",
    "security",
    "faults",
    "recovery",
    "properties",
    "claim_ceiling"
  ],
  "title": "ADVERSARIAL-001 connected synthetic campaign",
  "type": "object"
}
