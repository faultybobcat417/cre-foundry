{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cre-foundry.local/schemas/architecture-review-record-v1.json",
  "title": "CRE Foundry architecture manual-review sidecar record",
  "description": "Append-only sidecar subaggregate record for ARCHITECTURE-001 manual review. Encodes the frozen evaluator contract manual_review_contract: allowed actions only, forbidden actions always rejected, no gate/protection/rank/selection mutation, accepted evidence starts a fresh generation while the prior generation is preserved. Synthetic reviewer grants no real authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "document_kind",
    "schema_version",
    "execution_scope",
    "canonicalization",
    "aggregate_key",
    "review_sequence",
    "predecessor",
    "actor_class",
    "principal_reference",
    "action",
    "annotations",
    "evidence_request",
    "recorded_at",
    "grants_real_authority",
    "status",
    "forbidden_action"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "document_kind": {
      "const": "ARCHITECTURE_REVIEW_RECORD"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "execution_scope": {
      "const": "SYNTHETIC_NON_INFLUENCING"
    },
    "canonicalization": {
      "const": "SORTED_KEYS_INTEGER_JSON_V1"
    },
    "aggregate_key": {
      "$ref": "#/$defs/aggregate_key"
    },
    "review_sequence": {
      "type": "integer",
      "minimum": 1
    },
    "predecessor": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "review_id",
        "sha256"
      ],
      "properties": {
        "review_id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "actor_class": {
      "const": "MANUAL_REVIEWER"
    },
    "principal_reference": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "$ref": "#/$defs/allowed_action"
    },
    "annotations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_request": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "requested_evidence_kind",
        "reason"
      ],
      "properties": {
        "requested_evidence_kind": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "successor_generation": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "accepted_evidence_rule": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "new_stage1_snapshot_sha256",
        "preserve_prior_generation"
      ],
      "properties": {
        "new_stage1_snapshot_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "preserve_prior_generation": {
          "const": true
        }
      }
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "grants_real_authority": {
      "const": false
    },
    "status": {
      "enum": [
        "ACCEPTED",
        "REJECTED_FORBIDDEN"
      ]
    },
    "forbidden_action": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "aggregate_key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_scope",
        "representative_id",
        "route_date",
        "generation"
      ],
      "properties": {
        "execution_scope": {
          "const": "SYNTHETIC_NON_INFLUENCING"
        },
        "representative_id": {
          "type": "string",
          "minLength": 1
        },
        "route_date": {
          "type": "string",
          "format": "date"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "allowed_action": {
      "enum": [
        "ANNOTATE",
        "REQUEST_AUTHORITATIVE_EVIDENCE",
        "ABANDON_PREISSUANCE_GENERATION",
        "START_NEW_GENERATION"
      ]
    },
    "forbidden_action": {
      "enum": [
        "EDIT_FROZEN_STAGE1",
        "CHANGE_GATE_OR_PROTECTION_STATE",
        "INSERT_OR_DELETE_CANDIDATE",
        "CHANGE_VALUE_OR_RANK",
        "SWAP_SELECTED_STOP",
        "CLEAR_UNKNOWN",
        "HIDE_ABSTENTION_OR_ERROR",
        "DIRECT_ISSUE"
      ]
    }
  }
}
