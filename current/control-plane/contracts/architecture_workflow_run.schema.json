{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cre-foundry.local/schemas/architecture-workflow-run-v1.json",
  "title": "CRE Foundry architecture workflow run projection",
  "description": "Aggregate projection and replayable journal for one ARCHITECTURE-001 generation. Encodes the frozen evaluator contract reduction rule, atomic commit set, journal/lineage, idempotency records, issuance ledger, held outbox, effect ledger, result union, accessibility projection, and per-section receipt. Recursive-closed at every object definition.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_kind",
    "schema_version",
    "execution_scope",
    "canonicalization",
    "run_id",
    "aggregate_key",
    "aggregate_version",
    "initial_state",
    "state",
    "is_terminal",
    "commands",
    "events",
    "idempotency_records",
    "issuance_ledger",
    "held_outbox",
    "effect_ledger",
    "responses",
    "result",
    "accessibility_projection",
    "schema_bindings",
    "receipt",
    "owner",
    "proof"
  ],
  "properties": {
    "document_kind": {
      "const": "ARCHITECTURE_WORKFLOW_RUN"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "execution_scope": {
      "const": "SYNTHETIC_NON_INFLUENCING"
    },
    "canonicalization": {
      "const": "SORTED_KEYS_INTEGER_JSON_V1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "aggregate_key": {
      "$ref": "#/$defs/aggregate_key"
    },
    "aggregate_version": {
      "type": "integer",
      "minimum": 0
    },
    "initial_state": {
      "const": "COLLECTING_STAGE1"
    },
    "state": {
      "$ref": "#/$defs/state"
    },
    "is_terminal": {
      "type": "boolean"
    },
    "commands": {
      "type": "array",
      "items": {
        "$ref": "architecture_command.schema.json"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/journal_event"
      }
    },
    "idempotency_records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/idempotency_record"
      }
    },
    "issuance_ledger": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issuance_entry"
      }
    },
    "held_outbox": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/outbox_entry"
      }
    },
    "effect_ledger": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/effect_entry"
      }
    },
    "responses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/response"
      }
    },
    "result": {
      "$ref": "#/$defs/result"
    },
    "accessibility_projection": {
      "$ref": "architecture_accessibility_projection.schema.json"
    },
    "schema_bindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/schema_binding"
      }
    },
    "receipt": {
      "$ref": "#/$defs/receipt"
    },
    "owner": {
      "$ref": "#/$defs/owner"
    },
    "proof": {
      "$ref": "#/$defs/proof"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "aggregate_key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_scope",
        "representative_id",
        "route_date",
        "generation"
      ],
      "properties": {
        "execution_scope": {
          "const": "SYNTHETIC_NON_INFLUENCING"
        },
        "representative_id": {
          "type": "string",
          "minLength": 1
        },
        "route_date": {
          "type": "string",
          "format": "date"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "state": {
      "enum": [
        "COLLECTING_STAGE1",
        "STAGE1_FROZEN",
        "ISSUE_READY",
        "ISSUANCE_PREPARED",
        "ISSUED_INTERNAL",
        "ABSTAINED",
        "QUARANTINED",
        "SUPERSEDED",
        "VOIDED"
      ]
    },
    "result_status": {
      "enum": [
        "APPLIED",
        "IDEMPOTENT_REPLAY",
        "REJECTED",
        "CONFLICT",
        "HELD_UNAUTHORIZED"
      ]
    },
    "journal_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "command_id",
        "command_sha256",
        "aggregate_version",
        "predecessor_event_id",
        "predecessor_event_sha256",
        "from_state",
        "to_state",
        "event_sha256",
        "applied_at"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "command_id": {
          "type": "string",
          "minLength": 1
        },
        "command_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "aggregate_version": {
          "type": "integer",
          "minimum": 1
        },
        "predecessor_event_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "predecessor_event_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "from_state": {
          "$ref": "#/$defs/state"
        },
        "to_state": {
          "$ref": "#/$defs/state"
        },
        "event_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "applied_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "idempotency_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "idempotency_key",
        "aggregate_key",
        "command_type",
        "original_command_id",
        "status",
        "original_response_sha256"
      ],
      "properties": {
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        },
        "aggregate_key": {
          "$ref": "#/$defs/aggregate_key"
        },
        "command_type": {
          "type": "string",
          "minLength": 1
        },
        "original_command_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/result_status"
        },
        "original_response_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "issuance_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuance_slot",
        "route_manifest_sha256",
        "generation",
        "committed_at",
        "stop_count",
        "selected_candidate_ids",
        "selected_physical_location_ids",
        "external_effect_occurred"
      ],
      "properties": {
        "issuance_slot": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "execution_scope",
            "representative_id",
            "route_date"
          ],
          "properties": {
            "execution_scope": {
              "const": "SYNTHETIC_NON_INFLUENCING"
            },
            "representative_id": {
              "type": "string",
              "minLength": 1
            },
            "route_date": {
              "type": "string",
              "format": "date"
            }
          }
        },
        "route_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "committed_at": {
          "type": "string",
          "format": "date-time"
        },
        "stop_count": {
          "const": 10
        },
        "selected_candidate_ids": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "selected_physical_location_ids": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "external_effect_occurred": {
          "const": false
        }
      }
    },
    "outbox_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outbox_entry_id",
        "command_id",
        "status",
        "effect_class",
        "effect_sha256",
        "delivered_at"
      ],
      "properties": {
        "outbox_entry_id": {
          "type": "string",
          "minLength": 1
        },
        "command_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "HELD_UNAUTHORIZED"
        },
        "effect_class": {
          "const": "EXTERNAL_EFFECT_HELD_UNAUTHORIZED"
        },
        "effect_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "delivered_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "effect_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effect_id",
        "external_effect_occurred",
        "effect_kind"
      ],
      "properties": {
        "effect_id": {
          "type": "string",
          "minLength": 1
        },
        "external_effect_occurred": {
          "const": false
        },
        "effect_kind": {
          "enum": [
            "NONE",
            "HELD_OUTBOX_ONLY"
          ]
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_id",
        "status",
        "response_sha256",
        "response"
      ],
      "properties": {
        "command_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/result_status"
        },
        "response_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "response": {
          "$ref": "#/$defs/response_body"
        }
      }
    },
    "response_body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_status",
        "retry_allowed",
        "focus_target",
        "announcement_intent"
      ],
      "properties": {
        "result_status": {
          "$ref": "#/$defs/result_status"
        },
        "result": {
          "enum": [
            "ISSUE",
            "ABSTAIN_NO_VALID_TEN",
            "ERROR"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "diagnostic": {
          "type": [
            "string",
            "null"
          ]
        },
        "retry_allowed": {
          "type": "boolean"
        },
        "focus_target": {
          "type": [
            "string",
            "null"
          ]
        },
        "announcement_intent": {
          "enum": [
            "ASSERTIVE",
            "POLITE",
            "ALERT"
          ]
        },
        "evidence_reference_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "safe_next_actions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "schema_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "path",
        "schema_version",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "result": {
      "oneOf": [
        {
          "$ref": "#/$defs/issue_result"
        },
        {
          "$ref": "#/$defs/abstain_result"
        },
        {
          "$ref": "#/$defs/error_result"
        }
      ]
    },
    "issue_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "selected",
        "route_required",
        "reason",
        "external_effect_occurred"
      ],
      "properties": {
        "result": {
          "const": "ISSUE"
        },
        "selected": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "candidate_id",
              "physical_location_id"
            ],
            "properties": {
              "candidate_id": {
                "type": "string",
                "minLength": 1
              },
              "physical_location_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "route_required": {
          "const": true
        },
        "reason": {
          "type": "null"
        },
        "external_effect_occurred": {
          "const": false
        }
      }
    },
    "abstain_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "selected",
        "route",
        "reason",
        "downstream_effects_count",
        "external_effect_occurred"
      ],
      "properties": {
        "result": {
          "const": "ABSTAIN_NO_VALID_TEN"
        },
        "selected": {
          "type": "array",
          "maxItems": 0
        },
        "route": {
          "type": "null"
        },
        "reason": {
          "enum": [
            "PROTECTED_BUNDLE_INCOMPLETE",
            "UNRESOLVED_VALUE_COULD_DOMINATE",
            "NO_FEASIBLE_TEN"
          ]
        },
        "downstream_effects_count": {
          "const": 0
        },
        "external_effect_occurred": {
          "const": false
        }
      }
    },
    "error_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "selected",
        "route",
        "diagnostic",
        "safe_recovery_required",
        "downstream_effects_count",
        "external_effect_occurred"
      ],
      "properties": {
        "result": {
          "const": "ERROR"
        },
        "selected": {
          "type": "array",
          "maxItems": 0
        },
        "route": {
          "type": "null"
        },
        "diagnostic": {
          "type": "string",
          "minLength": 1
        },
        "safe_recovery_required": {
          "const": true
        },
        "downstream_effects_count": {
          "const": 0
        },
        "external_effect_occurred": {
          "const": false
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_stream_sha256",
        "event_stream_sha256",
        "aggregate_projection_sha256",
        "idempotency_sha256",
        "issuance_ledger_sha256",
        "outbox_sha256",
        "effect_ledger_sha256",
        "responses_sha256",
        "accessibility_projection_sha256",
        "final_state",
        "final_receipt_sha256",
        "claim_ceiling"
      ],
      "properties": {
        "command_stream_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "event_stream_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "aggregate_projection_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "idempotency_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "issuance_ledger_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "outbox_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "effect_ledger_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "responses_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "accessibility_projection_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "final_state": {
          "$ref": "#/$defs/state"
        },
        "final_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "claim_ceiling": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "real_world_authority"
      ],
      "properties": {
        "system": {
          "const": "CRE_FOUNDRY"
        },
        "real_world_authority": {
          "const": "UNASSIGNED_EXTERNAL_AUTHORITY"
        }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "claim",
        "live_issuance_authorized",
        "external_effect_occurred",
        "real_usability_proven",
        "accessibility_performance_or_conformance_proven",
        "production_atomicity_or_reliability_proven",
        "security_proven",
        "real_route_feasibility_proven",
        "deployment_authorized",
        "live_workflow_authorized",
        "incremental_lift_proven",
        "commercial_value_proven"
      ],
      "properties": {
        "level": {
          "const": 4
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "live_issuance_authorized": {
          "const": false
        },
        "external_effect_occurred": {
          "const": false
        },
        "real_usability_proven": {
          "const": false
        },
        "accessibility_performance_or_conformance_proven": {
          "const": false
        },
        "production_atomicity_or_reliability_proven": {
          "const": false
        },
        "security_proven": {
          "const": false
        },
        "real_route_feasibility_proven": {
          "const": false
        },
        "deployment_authorized": {
          "const": false
        },
        "live_workflow_authorized": {
          "const": false
        },
        "incremental_lift_proven": {
          "const": false
        },
        "commercial_value_proven": {
          "const": false
        }
      }
    }
  }
}
