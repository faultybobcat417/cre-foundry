{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cre-foundry.local/schemas/commercial-economics-v1.json",
  "title": "CRE Foundry risk-adjusted expected commercial value engine",
  "description": "Computes risk-adjusted expected net commercial value with explicit symbolic economics, uncertainty, costs, territories, services, and claim separation from realized value. A model passes only when commission, conversion, costs, and territories are explicit; no modeled value or appointment is ever called realized net commercial value; costs are never omitted; and downside/fallback policy is registered. Recursive-closed and intended to be judged by scripts/validate_economics_ecv.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_kind",
    "schema_version",
    "execution_scope",
    "services",
    "territories",
    "commission",
    "costs",
    "conversion",
    "downside",
    "fallback_policy",
    "claim_status",
    "proof",
    "claim_ceiling"
  ],
  "properties": {
    "document_kind": { "const": "COMMERCIAL_ECONOMICS_MODEL" },
    "schema_version": { "const": "1.0.0" },
    "execution_scope": { "const": "SYNTHETIC_NON_INFLUENCING" },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "territories": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "commission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rate", "basis"],
      "properties": {
        "rate": { "type": "number", "minimum": 0 },
        "basis": { "type": "string" }
      }
    },
    "costs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["line_item", "amount", "currency"],
        "properties": {
          "line_item": { "type": "string" },
          "amount": { "type": "number", "minimum": 0 },
          "currency": { "type": "string" }
        }
      }
    },
    "conversion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["distribution", "mean", "variance"],
      "properties": {
        "distribution": { "type": "string" },
        "mean": { "type": "number" },
        "variance": { "type": "number", "minimum": 0 }
      }
    },
    "downside": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "threshold"],
      "properties": {
        "metric": { "type": "string" },
        "threshold": { "type": "number" }
      }
    },
    "fallback_policy": { "type": "string" },
    "claim_status": {
      "const": "MODELED"
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "result"],
      "properties": {
        "level": { "const": 5 },
        "result": { "const": "PASS" }
      }
    },
    "claim_ceiling": { "type": "string" }
  }
}
