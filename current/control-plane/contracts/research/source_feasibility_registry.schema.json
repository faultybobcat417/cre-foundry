{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["artifact_id", "schema_version", "as_of", "status", "scope", "claim_ceiling", "bounded_conclusion", "sources", "external_gates"],
  "properties": {
    "artifact_id": {"const": "RESEARCH-001-SOURCE-REGISTRY"}, "schema_version": {"const": "2.0.0"},
    "as_of": {"type": "string", "format": "date"}, "status": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1}, "claim_ceiling": {"type": "string", "minLength": 1},
    "bounded_conclusion": {"type": "string", "minLength": 1},
    "external_gates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "sources": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/source"}}
  },
  "$defs": {"source": {
    "type": "object", "additionalProperties": false,
    "required": ["source_id", "publisher", "dataset_id", "resource_ids", "official_urls", "native_grains", "access", "terms", "clocks", "stage1_risks", "reproduction_probe_ids", "claim_ceiling", "history_status"],
    "properties": {
      "source_id": {"enum": ["ON-SELECT", "TOR-COA"]}, "publisher": {"type": "string", "minLength": 1},
      "dataset_id": {"type": "string", "minLength": 1}, "resource_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
      "official_urls": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "format": "uri"}},
      "native_grains": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
      "access": {"$ref": "#/$defs/access"}, "terms": {"$ref": "#/$defs/terms"},
      "clocks": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/clock"}},
      "stage1_risks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/risk"}},
      "reproduction_probe_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
      "claim_ceiling": {"type": "string", "minLength": 1},
      "history_status": {"enum": ["current_only_not_replayable", "annual_labels_not_publication_history", "replayable_point_in_time"]}
    }
  }, "access": {
    "type": "object", "additionalProperties": false,
    "required": ["metadata", "schema", "rows", "row_evidence_scope", "automation", "retention", "redistribution", "commercial_use"],
    "properties": {
      "metadata": {"enum": ["observed", "unavailable", "unknown"]}, "schema": {"enum": ["observed", "unavailable", "unknown"]},
      "rows": {"enum": ["not_acquired", "acquired_authorized", "unavailable", "unknown"]},
      "row_evidence_scope": {"enum": ["none", "narrow_aggregate_only", "narrow_counterexample_only", "authorized_operational_sample"]},
      "automation": {"enum": ["authorized", "prohibited", "unknown"]}, "retention": {"enum": ["authorized", "prohibited", "unknown"]},
      "redistribution": {"enum": ["authorized", "prohibited", "unknown"]}, "commercial_use": {"enum": ["authorized", "prohibited", "unknown"]}
    }
  }, "terms": {
    "type": "object", "additionalProperties": false,
    "required": ["status", "license_id", "terms_url", "observed_at", "evidence_ref", "permissions", "conditions", "exclusions", "repository_authority_granted"],
    "properties": {
      "status": {"enum": ["verified", "unspecified", "access_dependent", "not_applicable"]}, "license_id": {"type": "string", "minLength": 1},
      "terms_url": {"type": "string", "format": "uri"}, "observed_at": {"type": "string", "format": "date-time"},
      "evidence_ref": {"type": "string", "minLength": 1}, "permissions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
      "conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "exclusions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
      "repository_authority_granted": {"type": "boolean"}
    }
  }, "clock": {
    "type": "object", "additionalProperties": false, "required": ["clock_id", "source_field", "semantics", "stage1_use"],
    "properties": {"clock_id": {"type": "string"}, "source_field": {"type": "string"}, "semantics": {"type": "string"}, "stage1_use": {"type": "string"}}
  }, "risk": {
    "type": "object", "additionalProperties": false, "required": ["risk_id", "category", "description", "disposition", "gate_id"],
    "properties": {"risk_id": {"type": "string"}, "category": {"enum": ["grain", "temporal", "access", "terms", "privacy", "quality", "authority"]}, "description": {"type": "string"}, "disposition": {"enum": ["reject", "retain_separately", "gate", "experiment"]}, "gate_id": {"type": ["string", "null"]}}
  }}
}
