{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_id", "schema_version", "observed_at", "method", "claim_ceiling", "status", "probes", "witnesses"],
  "properties": {
    "artifact_id": {"const": "RESEARCH-001-PUBLIC-SOURCE-REPRODUCTION"},
    "schema_version": {"const": "2.0.0"},
    "observed_at": {"type": "string", "format": "date-time"},
    "method": {"const": "metadata_and_schema_reproduction"},
    "claim_ceiling": {"type": "string", "minLength": 1},
    "status": {"enum": ["pass", "partial", "fail"]},
    "probes": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["probe_id", "source_id", "acquisition_level", "request", "runs", "observations", "claim_ceiling"],
        "properties": {
          "probe_id": {"type": "string"},
          "source_id": {"type": "string"},
          "acquisition_level": {"enum": ["metadata", "schema", "current_rows"]},
          "request": {
            "type": "object",
            "additionalProperties": false,
            "required": ["method", "url", "argv"],
            "properties": {
              "method": {"const": "GET"},
              "url": {"type": "string", "format": "uri"},
              "argv": {"type": "array", "minItems": 2, "items": {"type": "string"}}
            }
          },
          "runs": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["role", "review_mode", "observed_at", "success", "http_status", "content_type", "response_sha256", "reported_total", "schema_sha256", "rows_acquired"],
              "properties": {
                "role": {"enum": ["builder", "independent_reviewer"]},
                "review_mode": {"enum": ["canonicalized_semantic_review", "exact_http_capture"]},
                "observed_at": {"type": "string", "format": "date-time"},
                "success": {"type": "boolean"},
                "http_status": {"type": ["integer", "null"]},
                "content_type": {"type": "string"},
                "response_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "reported_total": {"type": ["integer", "null"]},
                "schema_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
                "rows_acquired": {"type": "boolean"}
              }
            }
          },
          "observations": {
            "type": "object",
            "additionalProperties": false,
            "required": ["license_id", "current_as_of", "schema_fields", "history_proven", "authority_granted"],
            "properties": {
              "license_id": {"type": ["string", "null"]},
              "current_as_of": {"type": ["string", "null"]},
              "schema_fields": {"type": "array", "items": {"type": "string"}},
              "history_proven": {"const": false},
              "authority_granted": {"const": false}
            }
          },
          "claim_ceiling": {"type": "string", "minLength": 1}
        }
      }
    },
    "witnesses": {
      "type": "array",
      "minItems": 2,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["witness_id", "source_id", "reported_total_rows", "reported_distinct_licences", "reported_distinct_addresses_for_witness_licence", "acquisition_status", "query_evidence_id", "claim_ceiling"],
            "properties": {
              "witness_id": {"const": "WITNESS-ON-LICENCE-MULTIPLICITY"},
              "source_id": {"const": "ON-SELECT"},
              "reported_total_rows": {"type": "integer", "minimum": 1},
              "reported_distinct_licences": {"type": "integer", "minimum": 1},
              "reported_distinct_addresses_for_witness_licence": {"type": "integer", "minimum": 2},
              "acquisition_status": {"type": "string", "minLength": 1},
              "query_evidence_id": {"type": "string", "minLength": 1},
              "claim_ceiling": {"type": "string", "minLength": 1}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["witness_id", "source_id", "normalized_sys_id", "resource_ids", "conflict_summary", "acquisition_status", "claim_ceiling"],
            "properties": {
              "witness_id": {"const": "WITNESS-TOR-3209741"},
              "source_id": {"const": "TOR-COA"},
              "normalized_sys_id": {"const": "3209741"},
              "resource_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}},
              "conflict_summary": {"type": "string", "minLength": 1},
              "acquisition_status": {"type": "string", "minLength": 1},
              "claim_ceiling": {"type": "string", "minLength": 1}
            }
          }
        ]
      }
    }
  }
}
