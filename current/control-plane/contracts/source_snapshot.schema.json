{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cre-foundry.local/schemas/source-snapshot-v1.json",
  "title": "CRE Foundry immutable source snapshot store",
  "description": "Guarantees immutable source snapshots, normalized primitives, bitemporal reconstruction, and what-was-knowable replay without future leakage. A snapshot record is accepted only when the complete byte image was retrieved, its digest binds the exact bytes, every clock is monotonic per source, corrections are new revisions with visible provenance, and truncation or hash drift is never silently accepted. Recursive-closed and intended to be judged by scripts/validate_data_history.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_kind",
    "schema_version",
    "execution_scope",
    "snapshots",
    "reconstruction",
    "proof",
    "claim_ceiling"
  ],
  "properties": {
    "document_kind": {
      "const": "SOURCE_SNAPSHOT_STORE"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "execution_scope": {
      "const": "SYNTHETIC_NON_INFLUENCING"
    },
    "snapshots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "snapshot_id",
          "source_ref",
          "retrieved_at",
          "byte_count",
          "sha256",
          "complete",
          "available_at",
          "effective_at",
          "published_at",
          "correction_of",
          "tombstoned"
        ],
        "properties": {
          "snapshot_id": { "type": "string" },
          "source_ref": { "type": "string" },
          "retrieved_at": { "type": "string" },
          "byte_count": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "complete": { "type": "boolean" },
          "available_at": { "type": "string" },
          "effective_at": { "type": "string" },
          "published_at": { "type": "string" },
          "correction_of": { "type": ["string", "null"] },
          "tombstoned": { "type": "boolean" }
        }
      }
    },
    "reconstruction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["as_of", "visible_snapshot_ids", "checksum"],
      "properties": {
        "as_of": { "type": "string" },
        "visible_snapshot_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "checksum": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "result"],
      "properties": {
        "level": { "const": 5 },
        "result": { "const": "PASS" }
      }
    },
    "claim_ceiling": { "type": "string" }
  }
}
